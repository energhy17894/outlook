<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>OpsIntel.Intelligence</RootNamespace>
    <!-- Transitively pulls in Microsoft.AI.Foundry.Local (via OpsIntel.AI.Extraction), whose
         runtime package ships only RID-specific native assets — see that project's csproj
         and SPIKE-FOUNDRY-LOCAL.md. Declaring both RIDs here lets restore/build succeed on
         both this Linux dev/CI environment and the Windows production target without a
         `-r` flag. -->
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpsIntel.Contracts\OpsIntel.Contracts.csproj" />
    <ProjectReference Include="..\Platform\OpsIntel.Platform.Abstractions\OpsIntel.Platform.Abstractions.csproj" />
    <ProjectReference Include="..\Platform\OpsIntel.Platform.Windows\OpsIntel.Platform.Windows.csproj" />
    <ProjectReference Include="..\Platform\OpsIntel.Observability\OpsIntel.Observability.csproj" />
    <ProjectReference Include="..\Platform\OpsIntel.Persistence.Sqlite\OpsIntel.Persistence.Sqlite.csproj" />
    <ProjectReference Include="..\Modules\OpsIntel.AI.Extraction\OpsIntel.AI.Extraction.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>

</Project>
