<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>OpsIntel.SetupHelper</RootNamespace>
    <AssemblyName>OpsIntel.SetupHelper</AssemblyName>
    <!--
      ADR-0004 / Cert.wxs: invoked by a deferred, Impersonate="no" MSI custom action running as
      SYSTEM (msi_kurulum_dagitim.md §5: "avoid PowerShell custom actions" -> a signed helper exe
      instead). It never needs a GUI; keep it a plain console exe.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Only the raw SQLite ADO.NET provider is needed for `db backup` (online backup API);
      OpsIntel.Persistence.Sqlite's EF Core model is deliberately not referenced here so this
      exe stays a small, fast-starting installer helper (msi_kurulum_dagitim.md §5).
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

</Project>
