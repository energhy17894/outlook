<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>OpsIntel.UnitTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- OpsIntel.Intelligence pulls in Foundry Local, which ships RID-specific native assets
         only (see OpsIntel.AI.Extraction.csproj / SPIKE-FOUNDRY-LOCAL.md). -->
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\OpsIntel.Host\OpsIntel.Host.csproj" />
    <ProjectReference Include="..\..\..\src\OpsIntel.Intelligence\OpsIntel.Intelligence.csproj" />
    <ProjectReference Include="..\..\..\src\Platform\OpsIntel.Platform.Windows\OpsIntel.Platform.Windows.csproj" />
    <ProjectReference Include="..\..\..\src\Platform\OpsIntel.Persistence.Sqlite\OpsIntel.Persistence.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

</Project>
