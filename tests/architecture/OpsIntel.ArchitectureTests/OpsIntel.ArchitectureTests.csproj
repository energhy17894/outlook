<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>OpsIntel.ArchitectureTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Transitively references OpsIntel.AI.Extraction (via OpsIntel.Intelligence), whose
         Foundry Local dependency ships RID-specific native assets only — see that project's
         csproj and SPIKE-FOUNDRY-LOCAL.md. -->
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\OpsIntel.Contracts\OpsIntel.Contracts.csproj" />
    <ProjectReference Include="..\..\..\src\Platform\OpsIntel.Platform.Abstractions\OpsIntel.Platform.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\src\Platform\OpsIntel.Platform.Windows\OpsIntel.Platform.Windows.csproj" />
    <ProjectReference Include="..\..\..\src\OpsIntel.Intelligence\OpsIntel.Intelligence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="NetArchTest.Rules" />
  </ItemGroup>

</Project>
