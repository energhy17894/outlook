{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsintel:prompts:extraction:v1:project_assignment",
  "title": "ProjectAssignmentExtractionV1",
  "description": "Classifies a thread against a user-curated project registry (top-3-5 candidates supplied in the user prompt), never a free clustering call. 'new' and 'none' are always valid choices.",
  "type": "object",
  "additionalProperties": false,
  "required": ["chosen_project_id", "candidates", "needs_review", "evidence"],
  "properties": {
    "chosen_project_id": {
      "type": "string",
      "description": "Adaylardan biri, ya da hiçbiri uymuyorsa 'none', ya da metinde yeni ve tutarlı bir proje sinyali varsa 'new'."
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "description": "Kullanıcı isteminde verilen adaylardan (en fazla 5) değerlendirilenler, artı 'none'/'new'.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_id", "score"],
        "properties": {
          "project_id": { "type": "string" },
          "score": {
            "type": "string",
            "enum": ["reject", "weak", "strong"]
          }
        }
      }
    },
    "new_project_name_suggestion": {
      "type": ["string", "null"],
      "maxLength": 120,
      "description": "chosen_project_id == 'new' ise kısa bir öneri; kullanıcı onayı olmadan kayıt defterine yazılmaz."
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "med", "high"]
    },
    "needs_review": {
      "type": "boolean"
    },
    "abstain_reason": {
      "type": ["string", "null"],
      "enum": [null, "ambiguous_candidates", "unverifiable_quote", "possible_injection", "insufficient_context"]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message_id", "quote"],
        "properties": {
          "message_id": { "type": "string" },
          "quote": { "type": "string", "maxLength": 400 }
        }
      }
    }
  }
}
