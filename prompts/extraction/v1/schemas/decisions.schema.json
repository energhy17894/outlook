{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsintel:prompts:extraction:v1:decisions",
  "title": "DecisionExtractionV1",
  "description": "Decision extraction from one email thread. Accepted decisions are immutable in the data model (ADR-style records); a changed decision is a new record that supersedes the old one.",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "status", "confidence", "needs_review", "evidence"],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 240,
            "description": "Kısa karar özeti, ör. 'Teslim tarihi 15 Kasım'a ertelendi'."
          },
          "rationale": {
            "type": ["string", "null"],
            "maxLength": 400,
            "description": "Kararın gerekçesi, metinde açıkça varsa."
          },
          "decided_by_email": {
            "type": ["string", "null"],
            "description": "Kararı veren kişinin e-posta adresi. Belirsizse null."
          },
          "decided_at": {
            "type": ["string", "null"],
            "description": "ISO 8601 tarih (YYYY-MM-DD), metinden kesin çıkarılabiliyorsa; aksi halde null."
          },
          "status": {
            "type": "string",
            "enum": ["proposed", "accepted", "superseded", "reversed"]
          },
          "confidence": {
            "type": "string",
            "enum": ["low", "med", "high"]
          },
          "needs_review": {
            "type": "boolean"
          },
          "abstain_reason": {
            "type": ["string", "null"],
            "enum": [null, "ambiguous_decider", "ambiguous_date", "unverifiable_quote", "possible_injection", "insufficient_context"]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["message_id", "quote"],
              "properties": {
                "message_id": { "type": "string" },
                "quote": { "type": "string", "maxLength": 400 }
              }
            }
          }
        }
      }
    }
  }
}
