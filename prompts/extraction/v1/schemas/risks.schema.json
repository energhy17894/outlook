{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsintel:prompts:extraction:v1:risks",
  "title": "RiskExtractionV1",
  "description": "Risk (uncertain negative future event) extraction from one email thread. Kept separate from decisions/work-items to keep each schema small and flat (ExtractBench finding).",
  "type": "object",
  "additionalProperties": false,
  "required": ["risks"],
  "properties": {
    "risks": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "probability", "impact", "confidence", "needs_review", "evidence"],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 240,
            "description": "Kısa risk ifadesi, ör. 'Tedarikçi gecikirse teslim tarihi kayabilir'."
          },
          "probability": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "1 (çok düşük) - 5 (çok yüksek). Metinde açık dayanak yoksa 3 (orta) kullan ve confidence'ı low yap."
          },
          "impact": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "1 (çok düşük) - 5 (çok yüksek)."
          },
          "trend": {
            "type": ["string", "null"],
            "enum": [null, "rising", "stable", "falling"]
          },
          "mitigation": {
            "type": ["string", "null"],
            "maxLength": 300,
            "description": "Metinde önerilen azaltım eylemi, varsa."
          },
          "trigger": {
            "type": ["string", "null"],
            "maxLength": 200,
            "description": "Riskin gerçekleşmesine yol açacak koşul."
          },
          "confidence": {
            "type": "string",
            "enum": ["low", "med", "high"]
          },
          "needs_review": {
            "type": "boolean"
          },
          "abstain_reason": {
            "type": ["string", "null"],
            "enum": [null, "ambiguous_impact", "ambiguous_probability", "unverifiable_quote", "possible_injection", "insufficient_context"]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["message_id", "quote"],
              "properties": {
                "message_id": { "type": "string" },
                "quote": { "type": "string", "maxLength": 400 }
              }
            }
          }
        }
      }
    }
  }
}
