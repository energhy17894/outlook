{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsintel:prompts:extraction:v1:phase_signal",
  "title": "PhaseSignalExtractionV1",
  "description": "Detects a proposed phase transition for a project's finite-state lifecycle (e.g. Teklif -> Sözleşme -> Planlama -> Uygulama -> Test/Kabul -> Kapanış). Illegal jumps are rejected deterministically downstream; this call only proposes, with evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["phase_signals"],
  "properties": {
    "phase_signals": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_phase", "to_phase", "confidence", "needs_review", "evidence"],
        "properties": {
          "from_phase": {
            "type": "string",
            "description": "Kullanıcı isteminde verilen mevcut aşama kimliği (ör. 'teklif')."
          },
          "to_phase": {
            "type": "string",
            "description": "Önerilen yeni aşama kimliği (ör. 'sozlesme'). Kullanıcı isteminde verilen yaşam döngüsü şablonundaki bir aşama olmalı."
          },
          "signal_strength": {
            "type": "string",
            "enum": ["weak", "moderate", "strong"]
          },
          "confidence": {
            "type": "string",
            "enum": ["low", "med", "high"]
          },
          "needs_review": {
            "type": "boolean"
          },
          "abstain_reason": {
            "type": ["string", "null"],
            "enum": [null, "illegal_transition_suspected", "unverifiable_quote", "possible_injection", "insufficient_context"]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["message_id", "quote"],
              "properties": {
                "message_id": { "type": "string" },
                "quote": { "type": "string", "maxLength": 400 }
              }
            }
          }
        }
      }
    }
  }
}
